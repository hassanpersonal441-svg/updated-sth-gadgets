# ============================================================
# STH Gadgets — Environment Variables
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to version control.
# ============================================================

# Supabase project settings
# Find these in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SECRET. Used only in server-side API routes.
# Never expose this to the browser or commit it to git.
# Found in Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your deployed site URL (used for SEO metadata, sitemap, and WhatsApp product links)
# Use http://localhost:3000 during local development
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ============================================================
# WhatsApp & Make.com Automated Approval System Settings
# ============================================================

# Admin's 2nd WhatsApp Number for receiving instant order alerts (e.g. 923489593671 or 03489593671)
ADMIN_WHATSAPP_NUMBER=923489593671

# Make.com Scenario 1 Webhook URL (New Order -> Admin Notification)
MAKE_NEW_ORDER_WEBHOOK_URL=https://hook.eu1.make.com/your-new-order-webhook-id

# Make.com Scenario 2 Webhook URL (Order Approved -> Customer Notification)
MAKE_ORDER_APPROVED_WEBHOOK_URL=https://hook.eu1.make.com/your-approved-order-webhook-id

# Optional generic fallback Make.com Webhook URL
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-general-webhook-id

# WhatsApp Business Cloud API Settings (Used inside Make.com HTTP module or custom API calls)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
